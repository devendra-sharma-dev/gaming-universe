{
  "name": "gaming-universe",
  "version": "1.0.0",
  "private": true,
  "description": "Gaming Universe platform backend",
  "main": "backend/server.js",
  "scripts": {
    "build:frontend": "node scripts/build-frontend.js",
    "dev": "node --watch backend/server.js",
    "start": "node backend/server.js",
    "timeline:validate": "node scripts/validate-timeline-dataset.js",
    "timeline:import": "node scripts/import-timeline-dataset.js",
    "estimate-it:validate": "node scripts/validate-estimate-it-dataset.js",
    "estimate-it:import": "node scripts/import-estimate-it-dataset.js",
    "test": "node tests/mystery-country.test.js && node tests/session.test.js && node tests/estimate-it.test.js && node tests/estimate-it-flow.test.js && node tests/mini-olympics.test.js && node tests/mini-olympics-flow.test.js",
    "test:auth": "node tests/email-auth.test.js",
    "test:shared": "node tests/shared-games.test.js",
    "test:hosted": "node tests/email-auth.test.js --shared"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.0.10",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "mongodb-memory-server": "^11.2.0"
  }
}
